# ==============================================================================
# StandBharat Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure all required variables for your environment.
# DO NOT commit real secrets or credentials to source control.

# Application Environment (production, development, testing)
ENVIRONMENT=production

# Database Configuration (PostgreSQL)
# When running inside Docker Compose, POSTGRES_HOST should be "postgres"
# For local development outside containers, POSTGRES_HOST is "localhost"
POSTGRES_USER=standbharat_user
POSTGRES_PASSWORD=standbharat_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=standbharat_db
DATABASE_URL=postgresql://standbharat_user:standbharat_password@localhost:5432/standbharat_db

# Redis & Broker Configuration
# When running inside Docker Compose, REDIS_URL should be "redis://redis:6379/0"
# For host/local development, default is "redis://localhost:6380/0"
REDIS_URL=redis://localhost:6380/0

# Security & Cryptography
# CRITICAL: In production, SECRET_KEY must be a cryptographically random string
# of at least 32 characters (e.g. generated via `openssl rand -hex 32`).
# The application will refuse to start in production if this remains default.
SECRET_KEY=replace-with-cryptographically-secure-random-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dedicated Database Credential Encryption Key (Phase 38B)
# Used exclusively for encrypting OAuth tokens and third-party integration credentials at rest.
# Completely decoupled from SECRET_KEY (sessions) and BACKUP_ENCRYPTION_KEY (pg_dump backups).
# Must be either a 32-byte URL-safe base64 Fernet key (e.g. `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
# or a high-entropy secret string/passphrase (at least 32 characters).
# During transition, DB_ENCRYPTION_FALLBACK_TO_SECRET_KEY=true enables seamless reading of legacy credentials.
DB_ENCRYPTION_KEY=
DB_ENCRYPTION_FALLBACK_TO_SECRET_KEY=true

# Network & CORS Configuration
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DATA_MODE=api

# OAuth Integrations Configuration
# Google Analytics 4 (GA4) & Google Search Console (GSC)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback

# LinkedIn Publishing & Analytics
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# AI Provider Credentials (Optional / Configurable as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=

# Persistent Document Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage/documents
STORAGE_MAX_UPLOAD_SIZE_BYTES=26214400
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Database Connection Pooling Configuration
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Automated PostgreSQL Backup & Cold Storage Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_LOCAL_DIR=storage/backups/postgresql
BACKUP_STORAGE_BACKEND=local
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/postgresql
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
# Symmetric Fernet encryption key (32-byte url-safe base64 or secure passphrase).
# Leave blank for unencrypted backups; set to automatically enable artifact encryption.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_ENABLED=false
